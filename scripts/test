#!/usr/bin/env bash
# Run Lua specs against the pinned current KOReader Lua contract while keeping
# koplugin-dev's known-good compiled native runtime underneath.
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

args=()
if (( $# == 0 )); then
    args=(/opt/plugin/spec/)
else
    for arg in "$@"; do
        if [[ "$arg" == spec/* ]]; then
            args+=("/opt/plugin/$arg")
        else
            args+=("$arg")
        fi
    done
fi

exec "$ROOT_DIR/scripts/koreader-test-container" \
    --verbose \
    --helper=/opt/koplugin-dev/commonrequire.lua \
    --exclude-tags=e2e \
    "${args[@]}"
