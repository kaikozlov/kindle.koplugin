#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
IMAGE="ghcr.io/kaikozlov/koplugin-dev:v2026.07.1_1"
REFERENCE_DIR="$ROOT_DIR/REFERENCE/koreader"
EXPECTED_COMMIT="$(tr -d '[:space:]' < "$ROOT_DIR/KOREADER_TEST_COMMIT")"

if [[ ! -d "$REFERENCE_DIR/.git" ]]; then
    echo "Missing KOReader reference checkout at $REFERENCE_DIR" >&2
    echo "Check out koreader/koreader at $EXPECTED_COMMIT there before running Lua tests." >&2
    exit 2
fi

ACTUAL_COMMIT="$(git -C "$REFERENCE_DIR" rev-parse HEAD)"
if [[ "$ACTUAL_COMMIT" != "$EXPECTED_COMMIT" ]]; then
    echo "KOReader reference mismatch: expected $EXPECTED_COMMIT, found $ACTUAL_COMMIT" >&2
    exit 2
fi

for required in base/ffi/posix.lua base/ffi/netinfo.lua; do
    if [[ ! -f "$REFERENCE_DIR/$required" ]]; then
        echo "Missing KOReader base submodule file: $required" >&2
        echo "Run: git -C '$REFERENCE_DIR' submodule update --init base" >&2
        exit 2
    fi
done

exec docker run --rm \
    -e SDL_VIDEODRIVER=dummy \
    -v "$ROOT_DIR:/opt/plugin" \
    -v "$REFERENCE_DIR:/opt/reference-koreader:ro" \
    -e PLUGIN_NAME=kindle \
    "$IMAGE" \
    sh -lc '
        set -eu
        cd /opt/lib/koreader

        # Keep the image native libraries/device backend, but run the plugin
        # against the pinned KOReader Lua API surface it is developed for.
        cp /opt/reference-koreader/base/ffi/posix.lua ffi/posix.lua
        cp /opt/reference-koreader/base/ffi/netinfo.lua ffi/netinfo.lua
        cp -a /opt/reference-koreader/frontend/ui/. frontend/ui/
        cp -a /opt/reference-koreader/frontend/apps/filemanager/. frontend/apps/filemanager/
        cp -a /opt/reference-koreader/frontend/apps/reader/. frontend/apps/reader/
        cp /opt/reference-koreader/frontend/docsettings.lua frontend/docsettings.lua
        cp /opt/reference-koreader/frontend/document/documentregistry.lua frontend/document/documentregistry.lua
        cp /opt/reference-koreader/frontend/pluginloader.lua frontend/pluginloader.lua
        rm -rf plugins/coverbrowser.koplugin
        cp -a /opt/reference-koreader/plugins/coverbrowser.koplugin plugins/coverbrowser.koplugin

        exec busted-koreader "$@"
    ' koreader-test "$@"
