#!/usr/bin/env bash
# Rebuild the native Kindle reading-progress attach helper and Java agent.
#
# The Kindle ReaderSDK classes are not redistributable build dependencies, so
# agent/stubs/ contains compile-time-only API signatures recovered from the
# device bytecode. The stubs are never packaged; the agent links against the
# real Kindle framework classes after it is attached on-device.

set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
OUTPUT_DIR="${1:-$ROOT/bin}"
BUILD_DIR="$(mktemp -d "${TMPDIR:-/tmp}/kindle-progress-agent.XXXXXX")"
trap 'rm -rf "$BUILD_DIR"' EXIT

CLASSES="$BUILD_DIR/classes"
mkdir -p "$CLASSES" "$OUTPUT_DIR/classes"

STUBS=()
while IFS= read -r stub; do
    STUBS+=("$stub")
done < <(find "$ROOT/agent/stubs" -name '*.java' -type f | sort)

javac --release 11 \
    -d "$CLASSES" \
    "${STUBS[@]}" \
    "$ROOT/agent/src/AttachLauncher.java" \
    "$ROOT/agent/src/KindlePluginReadingProgressAgentV6.java"

cp "$CLASSES/AttachLauncher.class" "$OUTPUT_DIR/classes/AttachLauncher.class"

# Build the agent JAR ourselves instead of using `jar`. The JDK tool injects a
# compiler-specific Created-By field and DEFLATE output is not guaranteed to be
# byte-identical across hosts. Stored ZIP entries with fixed metadata make the
# committed agent bundle reproducible as long as its class bytecode is.
python3 - "$ROOT/agent/manifest-progress.mf" \
    "$CLASSES/KindlePluginReadingProgressAgentV6.class" \
    "$OUTPUT_DIR/native-reading-progress-agent-v6.jar" <<'PY'
import sys
import zipfile
from pathlib import Path

manifest_path, class_path, output_path = map(Path, sys.argv[1:])
manifest_lines = manifest_path.read_text(encoding="utf-8").splitlines()
manifest = ("\r\n".join(manifest_lines) + "\r\n\r\n").encode("utf-8")
class_bytes = class_path.read_bytes()

def entry(name, data, mode=0o644):
    info = zipfile.ZipInfo(name, date_time=(1980, 1, 1, 0, 0, 2))
    info.compress_type = zipfile.ZIP_STORED
    info.create_system = 3
    info.external_attr = mode << 16
    return info, data

with zipfile.ZipFile(output_path, "w") as bundle:
    directory = zipfile.ZipInfo("META-INF/", date_time=(1980, 1, 1, 0, 0, 2))
    directory.compress_type = zipfile.ZIP_STORED
    directory.create_system = 3
    directory.external_attr = (0o40755 << 16) | 0x10
    bundle.writestr(directory, b"")
    bundle.writestr(*entry("META-INF/MANIFEST.MF", manifest))
    bundle.writestr(*entry("KindlePluginReadingProgressAgentV6.class", class_bytes))
PY

chmod 0644 "$OUTPUT_DIR/classes/AttachLauncher.class" \
    "$OUTPUT_DIR/native-reading-progress-agent-v6.jar"
