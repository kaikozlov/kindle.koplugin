# Build crypto_hook.so against old glibc (Debian Bullseye = glibc 2.31)
# This .so is LD_PRELOADed into the Kindle's JVM (cvm/OpenJDK), so it must
# not require glibc symbols newer than what supported Kindle firmware ships.
#
# Targets:
#   (default)      — final artifact at /build/crypto_hook.so (copied by python_build.sh)
#   test-openssl11 — compile+run the hook harness against Debian Bullseye OpenSSL 1.1
#   test-openssl3  — compile+run the hook harness against Debian Bookworm OpenSSL 3
#
# The test targets execute the exact shipped ARM ELF under QEMU (linux/arm/v7).
# Each OpenSSL generation is tested twice: once when the executable links
# libcrypto directly, and once when an SDK-like helper brings libcrypto in via
# dlopen(..., RTLD_LOCAL). The latter reproduces the Bellatrix3 loader topology
# where forwarding through dlsym(RTLD_NEXT) cannot see the real OpenSSL symbol.

FROM arm32v7/debian:bullseye AS hook-build

RUN apt-get update && apt-get install -y --no-install-recommends gcc libc6-dev && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY lib/crypto_hook.c /build/crypto_hook.c

RUN gcc -shared -fPIC -O2 -o /build/crypto_hook.so /build/crypto_hook.c -ldl -lpthread && \
    strip /build/crypto_hook.so

# --- Hermetic executable tests -------------------------------------------------

FROM arm32v7/debian:bullseye AS test-openssl11

RUN apt-get update && apt-get install -y --no-install-recommends gcc libc6-dev libssl-dev && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY --from=hook-build /build/crypto_hook.so /build/crypto_hook.so
COPY test/drm/crypto_hook_harness.c /build/crypto_hook_harness.c
COPY test/drm/crypto_hook_dlopen_harness.c /build/crypto_hook_dlopen_harness.c

RUN gcc -O2 -o /build/crypto_hook_harness /build/crypto_hook_harness.c -lcrypto && \
    gcc -shared -fPIC -O2 -DCRYPTO_HOOK_DLOPEN_HELPER \
        -o /build/crypto_hook_dlopen_helper.so /build/crypto_hook_dlopen_harness.c -lcrypto && \
    gcc -O2 -o /build/crypto_hook_dlopen_loader /build/crypto_hook_dlopen_harness.c -ldl && \
    mkdir -p /mnt/us && \
    expected='EVP_256_KEY:000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f IV:a0a1a2a3a4a5a6a7a8a9aaabacadaeaf' && \
    for harness in /build/crypto_hook_harness /build/crypto_hook_dlopen_loader; do \
        rm -f /mnt/us/crypto_keys.log; \
        LD_PRELOAD=/build/crypto_hook.so "$harness"; \
        count="$(grep -c -x "$expected" /mnt/us/crypto_keys.log || true)"; \
        if [ "$count" != 1 ]; then \
            echo "openssl1.1: expected exactly 1 hook record from $harness, got $count:" >&2; \
            cat /mnt/us/crypto_keys.log >&2; \
            exit 1; \
        fi; \
        if grep -v -x "$expected" /mnt/us/crypto_keys.log | grep -q .; then \
            echo "openssl1.1: unexpected hook records from $harness:" >&2; \
            grep -v -x "$expected" /mnt/us/crypto_keys.log >&2; \
            exit 1; \
        fi; \
    done

FROM arm32v7/debian:bookworm AS test-openssl3

RUN apt-get update && apt-get install -y --no-install-recommends gcc libc6-dev libssl-dev && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY --from=hook-build /build/crypto_hook.so /build/crypto_hook.so
COPY test/drm/crypto_hook_harness.c /build/crypto_hook_harness.c
COPY test/drm/crypto_hook_dlopen_harness.c /build/crypto_hook_dlopen_harness.c

RUN gcc -O2 -o /build/crypto_hook_harness /build/crypto_hook_harness.c -lcrypto && \
    gcc -shared -fPIC -O2 -DCRYPTO_HOOK_DLOPEN_HELPER \
        -o /build/crypto_hook_dlopen_helper.so /build/crypto_hook_dlopen_harness.c -lcrypto && \
    gcc -O2 -o /build/crypto_hook_dlopen_loader /build/crypto_hook_dlopen_harness.c -ldl && \
    mkdir -p /mnt/us && \
    expected='EVP_256_KEY:000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f IV:a0a1a2a3a4a5a6a7a8a9aaabacadaeaf' && \
    for harness in /build/crypto_hook_harness /build/crypto_hook_dlopen_loader; do \
        rm -f /mnt/us/crypto_keys.log; \
        LD_PRELOAD=/build/crypto_hook.so "$harness"; \
        count="$(grep -c -x "$expected" /mnt/us/crypto_keys.log || true)"; \
        if [ "$count" != 1 ]; then \
            echo "openssl3: expected exactly 1 hook record from $harness, got $count:" >&2; \
            cat /mnt/us/crypto_keys.log >&2; \
            exit 1; \
        fi; \
        if grep -v -x "$expected" /mnt/us/crypto_keys.log | grep -q .; then \
            echo "openssl3: unexpected hook records from $harness:" >&2; \
            grep -v -x "$expected" /mnt/us/crypto_keys.log >&2; \
            exit 1; \
        fi; \
    done

# Default target: the release artifact python_build.sh copies from /build.
FROM hook-build
